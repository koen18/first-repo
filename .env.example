# Copy this file to .env and fill in real values.
# These EXPO_PUBLIC_ variables are safe to ship in the app - Supabase's
# anon key is meant to be public, real security comes from the Row Level
# Security policies in supabase/migrations/0001_init.sql.
#
# The OpenAI key is NOT set here - it lives only on the Supabase Edge
# Function (see supabase/functions/ai/README.md), never in the app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
